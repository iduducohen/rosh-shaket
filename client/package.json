{
  "name": "rosh-shaket-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node scripts/free-port.js 8100 && ng serve --port 8100",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "ng test --watch=false --code-coverage",
    "test:watch": "ng test",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "cap:sync": "ng build --configuration production && npx cap sync && node scripts/native-setup.mjs",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "native:setup": "node scripts/native-setup.mjs",
    "test:ci": "ng test --watch=false --code-coverage --browsers=ChromeHeadlessCI"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@azure/msal-browser": "^3.24.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/camera": "^6.0.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capgo/capacitor-social-login": "6.0.1",
    "@ionic/angular": "^8.3.0",
    "@ionic/pwa-elements": "^3.3.0",
    "@recognizebv/capacitor-plugin-msauth": "3.6.3",
    "@vercel/analytics": "^2.0.1",
    "ionicons": "^7.4.0",
    "pdfjs-dist": "^4.10.38",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@capacitor/cli": "^6.1.2",
    "@types/jasmine": "~5.1.0",
    "cypress": "^13.0.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.4"
  }
}
