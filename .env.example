# Optional: used by root docker-compose.yml only (maps into Authentication__* for the API container).
# For local `dotnet run`, do NOT use this file — use User Secrets (see docs/authentication-setup.md).
# Never commit a filled .env.

ANTHROPIC_API_KEY=
POSTGRES_PASSWORD=rosh_dev_password

# Flat names → docker-compose → Authentication__*
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
APPLE_SERVICES_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
AUTH_REDIRECT_ORIGIN=http://localhost:5051
AUTH_OTP_PEPPER=

SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# User documents: leave empty for the local docstore volume, or "s3" for a private AWS S3 bucket.
# The access key belongs to an IAM user limited to this bucket (see docs/ARCHITECTURE_WORKSPACES.md §4).
FileStorage__Provider=
FileStorage__S3__Bucket=
FileStorage__S3__Region=il-central-1
FileStorage__S3__KeyPrefix=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Reminder emails (a regular check for someone who still works, and Form 106 / the annual pension report
# at the end of a year). Nothing is sent until REMINDERS_ENABLED=true.
REMINDERS_ENABLED=false
# Public address of this API: the "stop reminders" link in every email points at it.
REMINDERS_PUBLIC_API_URL=
# The web app, for the "upload" button in the email. Empty = AUTH_REDIRECT_ORIGIN.
REMINDERS_APP_URL=
# Optional Resend template ids. Empty = the built-in HTML (server/src/RoshShaket.Infrastructure/Auth/EmailTemplates).
Authentication__Resend__Templates__ReviewReminder=
Authentication__Resend__Templates__YearEndReminder=
