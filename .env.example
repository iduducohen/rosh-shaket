# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
POSTGRES_PASSWORD=rosh_dev_password

# Sign-in providers (leave empty to hide a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=      # native iOS app
APPLE_SERVICES_ID=
MICROSOFT_CLIENT_ID=

# Email login codes. Without SMTP, codes are written to the API log (development).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
